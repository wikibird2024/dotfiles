{
  "permissions": {
    "additionalDirectories": [
      "/home/greystone/dotfiles"
    ]
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.local/bin/auto-shutdown ] && ~/.local/bin/auto-shutdown claude-start || true"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook UserPromptSubmit",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.local/bin/auto-shutdown ] && ~/.local/bin/auto-shutdown claude-stop || true"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook Stop",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.local/bin/claude-stm32-build-check ] && ~/.local/bin/claude-stm32-build-check || true",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.local/bin/auto-shutdown ] && ~/.local/bin/auto-shutdown claude-stop || true"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook SessionEnd",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook SessionStart",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook PreToolUse",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook PostToolUse",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook PermissionRequest",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook Notification",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook StopFailure",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "project-artifact@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
