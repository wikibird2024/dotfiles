# Keep the repo to hand-written config. Anything a program writes by itself
# (caches, history, backups, downloads) stays out.
# Check a path: git check-ignore -v <path>

# ── Backups and editor leftovers ─────────────────────────────
# *.bak* also catches dated copies (config.bak-20260927, .vimrc.bak.1727...)
*.bak*
*.old
*.orig
*.tmp
*~
*.swp
*.swo
.netrwhist
Session.vim

# ── History, logs ────────────────────────────────────────────
*.history
*.log

# ── Downloads and archives (fonts, installers: fetched by bootstrap) ──
*.zip
*.tar.gz
*.tgz
*.AppImage

# ── Caches and runtime data ──────────────────────────────────
.cache/
.local/
!theme/.local/
!claude/.local/
!niri/.local/
__pycache__/
# Electron/Chromium app data (e.g. a copied ~/.config/obsidian)
Cache/
Code Cache/
GPUCache/
DawnGraphiteCache/
DawnWebGPUCache/
Crashpad/
obsidian/

# ── IDE folders ──────────────────────────────────────────────
.vscode/
.idea/

# ── Plugins installed at runtime (Vim, Zsh) ──────────────────
vim/bundle/
vim/plugged/
vim/.vim/plugged/
zsh/custom/plugins/

# ── Secrets: this repo is public-facing ──────────────────────
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*.secret
.aider*
neovim/.config/github-copilot/

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Stow and machine-specific ────────────────────────────────
stow-*
# i3: this machine only (see i3_wm_endervour/.config/i3/local.conf.example)
i3_wm_endervour/.config/i3/local.conf
