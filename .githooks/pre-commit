#!/usr/bin/env bash
# Stop a commit that adds an API key, token or private key.
# Enabled per clone by: git config core.hooksPath .githooks (04_stow.sh does it).
# False alarm: add the line or path to .secretsignore. Skip once: git commit --no-verify

set -euo pipefail

if ! command -v ripsecrets >/dev/null 2>&1; then
    echo "pre-commit: ripsecrets not installed, secrets NOT checked (cargo install ripsecrets --locked)" >&2
    exit 0
fi

files=()
while IFS= read -r -d '' f; do
    files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ ${#files[@]} -eq 0 ] && exit 0

if ! ripsecrets --strict-ignore -- "${files[@]}"; then
    echo "" >&2
    echo "pre-commit: possible secret above, commit stopped." >&2
    echo "Move it to ~/.secrets (sourced by .bashrc), or add a false alarm to .secretsignore." >&2
    exit 1
fi
