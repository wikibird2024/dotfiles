#!/usr/bin/env bash
# theme — switch kitty, alacritty, tmux, Neovim and the niri bar/launcher/
# notifications/lock (when niri runs without Noctalia) and GTK apps (dark or
# light, from the palette background) to one color profile.
#
#   theme                     list profiles (* = active)
#   theme <name>              switch every tool to <name>, live
#   theme pick                choose a profile with fzf
#   theme new <name> [from]   start a profile as a copy of [from] (default: active)
#   theme check               check every profile for missing or broken files
#   theme gtk [dark|light]    GTK apps only (no argument: toggle); Mod+Shift+D in niri
#
# Profiles live in ~/.config/theme/themes/<name>/:
#   palette.conf  terminal colors (kitty syntax); alacritty.toml is generated from it
#   tmux.conf     @thm_* roles read by ~/.tmux.conf
#   nvim          key of the colorscheme.lua registry, optionally "key:variant"
# Every file is optional: a tool whose file is missing uses its own fallback
# colors (kitty theme.conf, alacritty colors-fallback.toml, the defaults in
# .tmux.conf, colorscheme.lua `fallback`). Each tool also works without this
# package at all. Starship uses ANSI color names, so it follows the terminal.
#
# The active profile is a symlink in ~/.local/state/theme/current, outside the
# repo, so switching never leaves a git diff.

set -euo pipefail

THEMES="$HOME/.config/theme/themes"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
CURRENT="$STATE/current"
NVIM_REGISTRY="$HOME/.config/nvim/lua/system/plugins/colorscheme.lua"
KITTY_FALLBACK="$HOME/.config/kitty/theme.conf"

die() {
	echo "theme: $*" >&2
	exit 1
}

active_name() {
	[ -L "$CURRENT" ] && basename "$(readlink "$CURRENT")" || true
}

names() {
	for d in "$THEMES"/*/; do
		[ -d "$d" ] && basename "$d"
	done
}

list() {
	local active
	active="$(active_name)"
	for name in $(names); do
		if [ "$name" = "$active" ]; then printf '* %s\n' "$name"; else printf '  %s\n' "$name"; fi
	done
}

# GTK apps (Nautilus, file dialogs, settings) dark or light. color-scheme
# drives GTK4/libadwaita apps; GTK3 apps need the "-dark" variant of the GTK
# theme (Yaru -> Yaru-dark), used only when that variant is installed.
set_gtk() {
	local mode="$1" theme base wanted
	command -v gsettings >/dev/null || return 0
	theme="$(gsettings get org.gnome.desktop.interface gtk-theme | tr -d "'")"
	base="${theme%-dark}"
	if [ "$mode" = dark ]; then wanted="$base-dark"; else wanted="$base"; fi
	gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode"
	if [ "$wanted" != "$theme" ] && { [ -d "/usr/share/themes/$wanted" ] || [ -d "$HOME/.themes/$wanted" ]; }; then
		gsettings set org.gnome.desktop.interface gtk-theme "$wanted"
	fi
}

# GTK mode to match the palette background. Without a palette: no change.
set_gtk_from_palette() {
	local palette="$1" bg brightness
	[ -f "$palette" ] || return 0
	bg="$(awk '$1 == "background" { print $2; exit }' "$palette")"
	[[ "$bg" =~ ^#[0-9a-fA-F]{6}$ ]] || return 0
	# perceived brightness 0-255
	brightness=$(((0x${bg:1:2} * 299 + 0x${bg:3:2} * 587 + 0x${bg:5:2} * 114) / 1000))
	if [ "$brightness" -lt 128 ]; then set_gtk dark; else set_gtk light; fi
}

# theme gtk dark|light|toggle: GTK apps only; terminals, tmux and Neovim keep
# the profile colors. The next `theme <name>` sets GTK from its palette again.
gtk() {
	local mode="${1:-toggle}"
	command -v gsettings >/dev/null || die "gtk needs gsettings"
	if [ "$mode" = toggle ]; then
		if [ "$(gsettings get org.gnome.desktop.interface color-scheme)" = "'prefer-dark'" ]; then
			mode=light
		else
			mode=dark
		fi
	fi
	case "$mode" in
	dark | light) set_gtk "$mode" ;;
	*) die "usage: theme gtk [dark|light|toggle]" ;;
	esac
	echo "theme: GTK apps $mode"
	if command -v notify-send >/dev/null; then
		notify-send -t 2000 "GTK apps: $mode" "Restart an open app if it keeps the old look" || true
	fi
}

# kitty palette.conf -> alacritty [colors] table
gen_alacritty() {
	awk '
		$1 == "background"           { bg = $2 }
		$1 == "foreground"           { fg = $2 }
		$1 == "cursor"               { cur = $2 }
		$1 == "cursor_text_color"    { curt = $2 }
		$1 == "selection_background" { selb = $2 }
		$1 == "selection_foreground" { self = $2 }
		$1 ~ /^color[0-9]+$/         { c[substr($1, 6) + 0] = $2 }
		END {
			split("black red green yellow blue magenta cyan white", n, " ")
			print "# Generated by `theme` from palette.conf — edit that file instead.\n"
			if (bg != "" || fg != "") {
				print "[colors.primary]"
				if (bg != "") printf "background = \"%s\"\n", bg
				if (fg != "") printf "foreground = \"%s\"\n", fg
				print ""
			}
			if (cur != "" || curt != "") {
				print "[colors.cursor]"
				if (curt != "") printf "text = \"%s\"\n", curt
				if (cur != "") printf "cursor = \"%s\"\n", cur
				print ""
			}
			if (selb != "" || self != "") {
				print "[colors.selection]"
				if (self != "") printf "text = \"%s\"\n", self
				if (selb != "") printf "background = \"%s\"\n", selb
				print ""
			}
			print "[colors.normal]"
			for (i = 0; i < 8; i++) if (i in c) printf "%-7s = \"%s\"\n", n[i + 1], c[i]
			print "\n[colors.bright]"
			for (i = 0; i < 8; i++) if ((i + 8) in c) printf "%-7s = \"%s\"\n", n[i + 1], c[i + 8]
		}' "$1"
}

switch() {
	local name="$1" dir="$THEMES/$1"
	[ -d "$dir" ] || {
		echo "theme: no profile '$name'. Available:" >&2
		list >&2
		exit 1
	}

	mkdir -p "$STATE"
	ln -sfn "$dir" "$CURRENT"

	local missing=()
	[ -f "$dir/palette.conf" ] || missing+=("palette.conf (kitty, alacritty)")
	[ -f "$dir/tmux.conf" ] || missing+=("tmux.conf")
	[ -f "$dir/nvim" ] || missing+=("nvim")

	# alacritty: the generated file sits on top of colors-fallback.toml;
	# without a palette, removing it lets the fallback show.
	# live_config_reload only watches the main file, so bump it
	if [ -f "$dir/palette.conf" ]; then
		gen_alacritty "$dir/palette.conf" >"$STATE/alacritty.toml"
	else
		rm -f "$STATE/alacritty.toml"
	fi
	[ -e "$HOME/.config/alacritty/alacritty.toml" ] && touch "$HOME/.config/alacritty/alacritty.toml"

	# kitty: recolor every running instance (each listens on unix:@kitty-<pid>,
	# see kitty.conf listen_on); --configured also makes it the default for new
	# windows. Without a palette, go back to kitty's own theme.conf
	local kitty_colors="$dir/palette.conf"
	[ -f "$kitty_colors" ] || kitty_colors="$KITTY_FALLBACK"
	if command -v kitty >/dev/null && [ -f "$kitty_colors" ]; then
		for pid in $(pgrep -x kitty || true); do
			kitty @ --to "unix:@kitty-$pid" set-colors --all --configured "$kitty_colors" 2>/dev/null || true
		done
	fi

	# tmux: load the new @thm_* roles; the bar redraws with them. Without a
	# tmux.conf, re-read ~/.tmux.conf so its default roles come back
	if tmux info >/dev/null 2>&1; then
		if [ -f "$dir/tmux.conf" ]; then
			tmux source-file "$dir/tmux.conf"
		else
			tmux source-file "$HOME/.tmux.conf"
		fi
		tmux refresh-client -S 2>/dev/null || true
	fi

	# Neovim: colorscheme.lua re-reads the profile on SIGUSR1 (its fallback
	# theme when the nvim file is missing)
	pkill -USR1 -x nvim 2>/dev/null || true

	# niri desktop without Noctalia (bar, launcher, notifications, lock): its
	# shell script regenerates their colors from the new palette
	if pgrep -x niri >/dev/null && [ -x "$HOME/.config/niri/scripts/shell" ]; then
		"$HOME/.config/niri/scripts/shell" colors || true
	fi

	set_gtk_from_palette "$dir/palette.conf"

	echo "theme: $name"
	for m in "${missing[@]}"; do
		echo "  no $m in this profile: that tool uses its fallback colors" >&2
	done
}

pick() {
	command -v fzf >/dev/null || die "pick needs fzf; use: theme <name>"
	local name
	name="$(list | fzf --prompt 'theme> ' --height 40% --reverse --no-multi \
		--preview "'$HOME/.local/bin/hexcolor' '$THEMES'/\$(echo {} | tr -d '* ')/palette.conf 2>/dev/null" |
		tr -d '* ')" || exit 0
	[ -n "$name" ] && switch "$name"
}

new() {
	local name="${1:-}" from="${2:-$(active_name)}"
	[ -n "$name" ] || die "usage: theme new <name> [from]"
	[[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "profile names use letters, digits, '.', '_' and '-' only"
	[ -e "$THEMES/$name" ] && die "profile '$name' already exists"
	[ -n "$from" ] && [ -d "$THEMES/$from" ] || die "no profile '$from' to copy from"
	cp -r "$THEMES/$from" "$THEMES/$name"
	echo "theme: created '$name' from '$from'. Edit, then run: theme $name"
	for f in "$THEMES/$name"/*; do echo "  $f"; done
}

# Report problems in every profile. Missing files are notes (the tool uses
# its fallback); broken values are errors. Exit 1 when there are errors.
check() {
	local errors=0 roles keys
	# the roles .tmux.conf defaults, i.e. the ones a profile should set
	roles="$(grep -oE '^set -g @thm_[a-z_]+' "$HOME/.tmux.conf" 2>/dev/null | awk '{print $3}' | sort -u)"
	keys="$(grep -oE '^    [A-Za-z0-9_]+ = \{' "$NVIM_REGISTRY" 2>/dev/null | awk '{print $1}')"

	for name in $(names); do
		local dir="$THEMES/$name" out=()
		if [ -f "$dir/palette.conf" ]; then
			for k in background foreground; do
				grep -qE "^${k}[[:space:]]+#[0-9a-fA-F]{6}\b" "$dir/palette.conf" || out+=("error: palette.conf has no valid '$k'")
			done
			for i in $(seq 0 15); do
				grep -qE "^color${i}[[:space:]]+#[0-9a-fA-F]{6}\b" "$dir/palette.conf" || out+=("error: palette.conf has no valid 'color$i'")
			done
		else
			out+=("note:  no palette.conf (kitty and alacritty use their fallback)")
		fi
		if [ -f "$dir/tmux.conf" ]; then
			for r in $roles; do
				grep -qE "^set -g ${r}[[:space:]]+\"#[0-9a-fA-F]{6}\"" "$dir/tmux.conf" || out+=("error: tmux.conf has no valid $r (the bar falls back to the default for it)")
			done
		else
			out+=("note:  no tmux.conf (tmux uses the defaults in .tmux.conf)")
		fi
		if [ -f "$dir/nvim" ]; then
			local key
			key="$(head -n1 "$dir/nvim" | cut -d: -f1 | tr -d '[:space:]')"
			if [ -n "$keys" ] && ! grep -qx "$key" <<<"$keys"; then
				out+=("error: nvim names '$key', which is not in colorscheme.lua (Neovim uses its fallback)")
			fi
		else
			out+=("note:  no nvim file (Neovim uses its fallback theme)")
		fi

		if [ ${#out[@]} -eq 0 ]; then
			echo "ok     $name"
		else
			echo "$name:"
			for o in "${out[@]}"; do
				echo "  $o"
				[[ "$o" == error:* ]] && errors=$((errors + 1))
			done
		fi
	done
	[ "$errors" -eq 0 ]
}

case "${1:-}" in
"") list ;;
pick) pick ;;
new) new "${2:-}" "${3:-}" ;;
check) check ;;
gtk) gtk "${2:-}" ;;
-h | --help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" ;;
*) switch "$1" ;;
esac
