#!/usr/bin/env bash
# Desktop shell for niri: bar, launcher, panels, lock, media keys.
#   shell <command>
# Uses Noctalia when it is installed (Arch). Without it (Ubuntu 24.04 has no
# Noctalia package) it uses apt tools: waybar, fuzzel, swaync, swaylock,
# swayidle, swaybg, cliphist, wpctl, brightnessctl, playerctl, rudo (dock).
# Per machine, `shell use waybar` keeps the apt tools even with Noctalia
# installed (`shell use noctalia` goes back); the choice is kept in
# ~/.local/state/niri/shell, outside the repo.
# Commands: use start launcher control-center settings clipboard wallpaper session
#           lock lock-and-suspend window-switcher volume-up volume-down
#           volume-mute mic-mute brightness-up brightness-down
#           media-toggle media-next media-previous
#           notifications-panel notifications-clear notifications-dnd
#           colors (re-read the `theme` colors; the theme command runs it)
set -uo pipefail

command=${1:?usage: shell <command>}
self=$(readlink -f "$0")
wallpaper_dir=~/Pictures/wallpaper
wallpaper_link=${XDG_STATE_HOME:-~/.local/state}/niri/wallpaper
notify_id_file=${XDG_RUNTIME_DIR:-/tmp}/niri-shell-osd-id
palette=${XDG_STATE_HOME:-~/.local/state}/theme/current/palette.conf
generated_dir=${XDG_CACHE_HOME:-~/.cache}/niri-shell

has() { command -v "$1" >/dev/null 2>&1; }

# Which shell this machine runs: the saved choice, else Noctalia if installed.
choice_file=${XDG_STATE_HOME:-~/.local/state}/niri/shell
backend=$(cat "$choice_file" 2>/dev/null)
case $backend in
    noctalia | waybar) ;;
    *) has noctalia && backend=noctalia || backend=waybar ;;
esac
[ "$backend" = noctalia ] && ! has noctalia && backend=waybar

if [ "$command" = use ]; then
    new=${2:-}
    case $new in
        noctalia | waybar) ;;
        *)
            echo "usage: shell use noctalia|waybar   (now: $backend)" >&2
            exit 2
            ;;
    esac
    if [ "$new" = noctalia ] && ! has noctalia; then
        echo "shell: noctalia is not installed" >&2
        exit 1
    fi
    mkdir -p "$(dirname "$choice_file")"
    echo "$new" >"$choice_file"
    # stop both sets, then start the chosen one detached from this terminal
    pkill -u "$USER" -x noctalia
    systemctl --user stop niri-waybar.service niri-swayidle.service swaync.service 2>/dev/null
    for program in waybar swaync rudo swayidle swaybg; do pkill -u "$USER" -x "$program"; done
    pkill -u "$USER" -f 'wl-paste --watch cliphist'
    # the theme focus ring is only kept up to date for waybar
    [ "$new" = noctalia ] && rm -f "$generated_dir/colors.kdl"
    sleep 0.3
    setsid -f "$self" start </dev/null >/dev/null 2>&1
    echo "niri shell: $new"
    exit 0
fi

if [ "$backend" = noctalia ]; then
    case $command in
        start) exec noctalia ;;
        colors) exit 0 ;; # Noctalia has its own color settings
        notifications-*) exit 0 ;; # Noctalia has its own notification panel
        launcher | control-center | clipboard | wallpaper | session) exec noctalia msg panel-toggle "$command" ;;
        settings) exec noctalia msg settings-toggle ;;
        lock | lock-and-suspend) exec noctalia msg session "$command" ;;
        media-*) exec noctalia msg media "${command#media-}" ;;
        *) exec noctalia msg "$command" ;;
    esac
fi

# ── apt tools ────────────────────────────────────────────────────────

# Start a background program if it is installed and not already running.
# Input from /dev/null too: a program that kept the caller's terminal (e.g. the
# tmux theme popup, `theme` -> `shell colors`) would stop that popup closing.
start_once() {
    local program=$1
    has "$program" || return 0
    pgrep -u "$USER" -x "$program" >/dev/null && return 0
    setsid -f "$@" </dev/null >/dev/null 2>&1
}

# Long-running parts (bar, idle timer): the user units niri-waybar and
# niri-swayidle (niri/.config/systemd/user/), which restart after a crash and log
# to the journal (journalctl --user -u niri-waybar). Not enabled, so only niri
# starts them; they stop with the session.
start_service() {
    local name=$1
    has "$name" || return 0
    systemctl --user is-active --quiet "niri-$name.service" && return 0
    # a copy started the old way (by hand, or before the units existed) would double up
    pkill -u "$USER" -x "$name"
    systemctl --user reset-failed "niri-$name.service" 2>/dev/null
    systemctl --user start "niri-$name.service"
}

# On-screen value (volume, brightness): one notification that replaces itself.
osd() {
    local title=$1 percent=$2 last_id
    has notify-send || return 0
    last_id=$(cat "$notify_id_file" 2>/dev/null)
    [[ $last_id =~ ^[0-9]+$ ]] || last_id=0
    # the synchronous hint: swaync draws the value as a bar only with it
    notify-send -a osd -t 1500 -h "int:value:$percent" -h string:x-canonical-private-synchronous:osd \
        -r "$last_id" -p "$title" "$percent%" >"$notify_id_file"
}

volume_percent() {
    wpctl get-volume "$1" | awk '{ printf "%d", $2 * 100 }'
}

show_volume() {
    local target=$1 name=$2
    if wpctl get-volume "$target" | grep -q MUTED; then
        osd "$name muted" 0
    else
        osd "$name" "$(volume_percent "$target")"
    fi
}

# Colors from the active `theme` profile (palette.conf), else neutral grays.
# waybar and fuzzel 1.9 get a generated config: the repo file plus these
# colors, in $generated_dir. rudo and swaync read only a fixed style.css, so
# theirs is written next to the repo file (not tracked).
write_colors() {
    local bg='#1e1e1e' fg='#e0e0e0' accent='#909090' muted='#606060' red='#cc4444' yellow='#e0b050' selection='#3a3a3a'
    if [ -f "$palette" ]; then
        eval "$(awk '
            $1 == "background"           { print "bg=" $2 }
            $1 == "foreground"           { print "fg=" $2 }
            $1 == "selection_background" { print "selection=" $2 }
            $1 == "color1"               { print "red=" $2 }
            $1 == "color3"               { print "yellow=" $2 }
            $1 == "color4"               { print "accent=" $2 }
            $1 == "color8"               { print "muted=" $2 }' "$palette" |
            grep -E '^[a-z]+=#[0-9a-fA-F]{6}$')"
    fi
    mkdir -p "$generated_dir"

    # for waybar-workspaces and swaylock
    printf 'bg=%s\nfg=%s\naccent=%s\nmuted=%s\nred=%s\nselection=%s\n' \
        "$bg" "$fg" "$accent" "$muted" "$red" "$selection" >"$generated_dir/colors.sh"

    {
        printf '@define-color %s %s;\n' bg "$bg" fg "$fg" accent "$accent" muted "$muted" \
            red "$red" yellow "$yellow" selection "$selection"
        cat ~/.config/waybar/style.css
    } >"$generated_dir/waybar.css"

    {
        cat ~/.config/fuzzel/fuzzel.ini 2>/dev/null
        # fuzzel 1.9 (Ubuntu 24.04) has no prompt/input colors yet.
        # Background 85% opaque (d9): niri blurs what is behind it (layer-rule launcher)
        printf '\n[colors]\nbackground=%sd9\ntext=%sff\nmatch=%sff\n' \
            "${bg#\#}" "${fg#\#}" "${accent#\#}"
        printf 'selection=%sff\nselection-text=%sff\nselection-match=%sff\nborder=%sff\n' \
            "${selection#\#}" "${fg#\#}" "${accent#\#}" "${accent#\#}"
    } >"$generated_dir/fuzzel.ini"

    # rudo reads only ~/.config/rudo/style.css and re-reads it when it changes;
    # write a temp file and rename, so it never loads a half-written one
    if [ -f ~/.config/rudo/dock.css ]; then
        {
            printf '@define-color %s %s;\n' bg "$bg" fg "$fg" accent "$accent" muted "$muted" \
                selection "$selection"
            cat ~/.config/rudo/dock.css
        } >~/.config/rudo/.style.css.new && mv ~/.config/rudo/.style.css.new ~/.config/rudo/style.css
    fi

    # swaync (notifications) reads ~/.config/swaync/style.css; `shell colors` reloads it
    if [ -f ~/.config/swaync/notifications.css ]; then
        {
            printf '@define-color %s %s;\n' bg "$bg" fg "$fg" accent "$accent" muted "$muted" \
                red "$red" selection "$selection"
            cat ~/.config/swaync/notifications.css
        } >~/.config/swaync/.style.css.new && mv ~/.config/swaync/.style.css.new ~/.config/swaync/style.css
    fi

    # niri focus ring: config.kdl includes this file and reloads when it changes
    printf 'layout {\n    focus-ring {\n        active-color "%s"\n        inactive-color "%s"\n        urgent-color "%s"\n    }\n}\n' \
        "$accent" "$muted" "$red" >"$generated_dir/colors.kdl"
}

run_fuzzel() {
    [ -f "$generated_dir/fuzzel.ini" ] || write_colors
    fuzzel --config "$generated_dir/fuzzel.ini" "$@"
}

# fuzzel as a menu; closes it instead when it is already open (key pressed twice).
menu() {
    if pgrep -u "$USER" -x fuzzel >/dev/null; then
        pkill -u "$USER" -x fuzzel
        return 1
    fi
    run_fuzzel --dmenu "$@"
}

start_wallpaper() {
    local image old
    image=$(readlink -f "$wallpaper_link" 2>/dev/null)
    [ -f "$image" ] || image=$(find "$wallpaper_dir" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) 2>/dev/null | sort | head -n1)
    [ -n "$image" ] || return 0
    has swaybg || return 0
    old=$(pgrep -u "$USER" -x swaybg)
    setsid -f swaybg -m fill -i "$image" </dev/null >/dev/null 2>&1
    # shellcheck disable=SC2086 # one pid per word
    [ -n "$old" ] && { sleep 0.3; kill $old 2>/dev/null; }
}

case $command in
    start)
        write_colors
        start_wallpaper
        start_service waybar
        # notifications: the package's own unit (D-Bus starts the same one), which
        # restarts after a crash and reads ~/.config/swaync/
        has swaync && systemctl --user start swaync.service
        # dock on the left edge, always shown (~/.config/rudo), for people who don't know the keys
        start_once rudo
        # password prompts for apps that need admin rights (Ubuntu path, then Arch)
        for agent in /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
            /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do
            [ -x "$agent" ] || continue
            pgrep -u "$USER" -f "$agent" >/dev/null || setsid -f "$agent" </dev/null >/dev/null 2>&1
            break
        done
        has cliphist && has wl-paste && ! pgrep -u "$USER" -f 'wl-paste --watch cliphist' >/dev/null &&
            setsid -f wl-paste --watch cliphist store </dev/null >/dev/null 2>&1
        # lock after 5 min (company rule), screens off after 6 min: niri-swayidle.service
        start_service swayidle
        ;;
    launcher)
        if pgrep -u "$USER" -x fuzzel >/dev/null; then pkill -u "$USER" -x fuzzel; else run_fuzzel; fi
        ;;
    control-center)
        # GNOME Settings only shows its panels under a GNOME desktop name
        XDG_CURRENT_DESKTOP=GNOME exec gnome-control-center
        ;;
    settings)
        exec kitty -e nvim ~/.config/niri/config.kdl
        ;;
    clipboard)
        choice=$(cliphist list | menu --prompt 'clipboard> ') || exit 0
        cliphist decode <<<"$choice" | wl-copy
        ;;
    wallpaper)
        name=$(find "$wallpaper_dir" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) -printf '%f\n' |
            sort | menu --prompt 'wallpaper> ') || exit 0
        mkdir -p "$(dirname "$wallpaper_link")"
        ln -sfn "$wallpaper_dir/$name" "$wallpaper_link"
        start_wallpaper
        ;;
    session)
        items=(Lock 'Log out' Suspend Reboot 'Power off')
        # auto shutdown (~/.local/bin/auto-shutdown) is switched only here
        auto_shutdown=~/.local/bin/auto-shutdown
        if [ -x "$auto_shutdown" ]; then
            if "$auto_shutdown" is-on; then
                items+=('Auto shutdown: turn off')
            else
                items+=('Auto shutdown: turn on (after 30 min idle)')
            fi
        fi
        choice=$(printf '%s\n' "${items[@]}" |
            menu --prompt 'power> ' --lines "${#items[@]}") || exit 0
        case $choice in
            Lock) "$self" lock ;;
            'Log out') niri msg action quit --skip-confirmation ;;
            Suspend) systemctl suspend ;;
            Reboot) systemctl reboot ;;
            'Power off') systemctl poweroff ;;
            'Auto shutdown: turn off') "$auto_shutdown" off ;;
            'Auto shutdown: turn on'*) "$auto_shutdown" on 30 ;;
        esac
        ;;
    lock)
        pgrep -u "$USER" -x swaylock >/dev/null && exit 0
        [ -f "$generated_dir/colors.sh" ] || write_colors
        # shellcheck source=/dev/null
        . "$generated_dir/colors.sh"
        swaylock -f -c "${bg#\#}" -F \
            --inside-color "${bg#\#}" --ring-color "${accent#\#}" --key-hl-color "${fg#\#}" \
            --line-color 00000000 --separator-color 00000000 --text-color "${fg#\#}" \
            --inside-ver-color "${bg#\#}" --ring-ver-color "${accent#\#}" --text-ver-color "${fg#\#}" \
            --inside-wrong-color "${bg#\#}" --ring-wrong-color "${red#\#}" --text-wrong-color "${red#\#}" \
            --inside-clear-color "${bg#\#}" --ring-clear-color "${muted#\#}" --text-clear-color "${fg#\#}"
        ;;
    lock-and-suspend)
        "$self" lock
        systemctl suspend
        ;;
    window-switcher)
        windows=$(niri msg --json windows)
        index=$(jq -r '.[] | "\(.app_id // "?")  —  \(.title // "")"' <<<"$windows" |
            menu --prompt 'window> ' --index) || exit 0
        niri msg action focus-window --id "$(jq -r --argjson i "$index" '.[$i].id' <<<"$windows")"
        ;;
    volume-up)
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
        show_volume @DEFAULT_AUDIO_SINK@ Volume
        ;;
    volume-down)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
        show_volume @DEFAULT_AUDIO_SINK@ Volume
        ;;
    volume-mute)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        show_volume @DEFAULT_AUDIO_SINK@ Volume
        ;;
    mic-mute)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        show_volume @DEFAULT_AUDIO_SOURCE@ Microphone
        ;;
    brightness-up | brightness-down)
        [ "$command" = brightness-up ] && step=5%+ || step=5%-
        brightnessctl -q set "$step"
        osd Brightness "$(brightnessctl -m | cut -d, -f4 | tr -d %)"
        ;;
    colors)
        write_colors
        pkill -USR2 -u "$USER" -x waybar # waybar re-reads its style
        swaync-client -rs -sw >/dev/null 2>&1 || true # rudo re-reads style.css by itself
        ;;
    # swaync: the panel under the bar's bell (also Mod+N), clear all, do-not-disturb.
    # -sw: do nothing when swaync is not running, instead of waiting for it.
    notifications-panel) swaync-client -t -sw ;;
    notifications-clear) swaync-client -C -sw ;;
    notifications-dnd) swaync-client -d -sw >/dev/null ;;
    media-toggle) playerctl play-pause ;;
    media-next) playerctl next ;;
    media-previous) playerctl previous ;;
    *)
        echo "shell: unknown command '$command'" >&2
        exit 2
        ;;
esac
