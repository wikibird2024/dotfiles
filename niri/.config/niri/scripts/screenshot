#!/usr/bin/env bash
# Screenshot keys for niri (Print, Insert, Mod+Shift+S, Ctrl+Print).
#   screenshot area   pick an area (slurp), then draw on it in satty
#                     (Ctrl+C / Enter copy and close, Ctrl+S save, Esc cancel)
#   screenshot full   whole screen, saved to ~/Pictures/Screenshots and copied
# Flameshot is not used on niri: Wayland builds without USE_WAYLAND_CLIPBOARD
# remove the whole copy feature (flameshot issue #2848) — see niri/README.md.
# Output goes to ~/.cache/niri-shell/screenshot.log.
set -uo pipefail

mode=${1:?usage: screenshot area|full}
save_dir=~/Pictures/Screenshots

mkdir -p "$save_dir" ~/.cache/niri-shell
exec >>~/.cache/niri-shell/screenshot.log 2>&1
echo "== $(date) $mode"

case $mode in
    area)
        area=$(slurp -d) && grim -t ppm -g "$area" - | satty -f -
        ;;
    full)
        picture="$save_dir/Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png"
        grim "$picture" && wl-copy --type image/png <"$picture"
        ;;
    *) echo "usage: screenshot area|full" && exit 2 ;;
esac
echo "exit=$?"
