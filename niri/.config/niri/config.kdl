// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://github.com/niri-wm/niri/wiki/Configuration:-Introduction

// Push the mouse into the top-left corner: open/close the overview.
gestures {
    hot-corners {
        top-left
    }
}

// Input device configuration.
// Find the full list of options on the wiki:
// https://github.com/niri-wm/niri/wiki/Configuration:-Input
input {
    keyboard {
        xkb {
            // You can set rules, model, layout, variant and options.
            // For more information, see xkeyboard-config(7).

            // For example:
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"

            // If this section is empty, niri will fetch xkb settings
            // from org.freedesktop.locale1. You can control these using
            // localectl set-x11-keymap.
        }

        // Enable numlock on startup, omitting this setting disables it.
        numlock
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    // Uncomment this to make the mouse warp to the center of newly focused windows.
    // warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    // focus-follows-mouse max-scroll-amount="0%"
}

// You can configure outputs by their name, which you can find
// by running `niri msg outputs` while inside a niri instance.
// The built-in laptop monitor is usually called "eDP-1".
// Find more information on the wiki:
// https://github.com/niri-wm/niri/wiki/Configuration:-Outputs
// Remember to uncomment the node by removing "/-"!
// The laptop's own screen; this desktop PC uses DP-3 with its default settings.
/-output "eDP-2" {
    mode "2560x1600@239.998993"
    position x=2560 y=0
    variable-refresh-rate
}
// Settings that influence how windows are positioned and sized.
// Find more information on the wiki:
// https://github.com/niri-wm/niri/wiki/Configuration:-Layout
layout {
    // Set gaps around windows in logical pixels.
    gaps 6
    focus-ring {
        width 2
    }
    background-color "transparent"
    // When to center a column when changing focus, options are:
    // - "never", default behavior, focusing an off-screen column will keep at the left
    //   or right edge of the screen.
    // - "always", the focused column will always be centered.
    // - "on-overflow", focusing a column will center it if it doesn't fit
    //   together with the previously focused column.
    center-focused-column "never"
    // You can customize the widths that "switch-preset-column-width" (Mod+R) toggles between.
    preset-column-widths {
        // Proportion sets the width as a fraction of the output width, taking gaps into account.
        // For example, you can perfectly fit four windows sized "proportion 0.25" on an output.
        // The default preset widths are 1/3, 1/2 and 2/3 of the output.
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        // Fixed sets the width in logical pixels exactly.
        // fixed 1920
    }
    // You can also customize the heights that "switch-preset-window-height" (Mod+Shift+R) toggles between.
    // preset-window-heights { }
    // You can change the default width of the new windows.
    default-column-width { proportion 0.5; }
    // If you leave the brackets empty, the windows themselves will decide their initial width.
    // default-column-width {}
    // By default focus ring and border are rendered as a solid background rectangle
    // behind windows. That is, they will show up through semitransparent windows.
    // This is because windows using client-side decorations can have an arbitrary shape.
    //
    // `prefer-no-csd` (set below) makes niri draw the focus ring and border *around*
    // windows that agree to omit their client-side decorations.
    //
    // Alternatively, you can override it with a window rule called
    // `draw-border-with-background`.
    border {
        off
        width 4
        active-color   "#707070"      // Neutral gray
        inactive-color "#d0d0d0"      // Light gray
        urgent-color   "#cc4444"      // Softer red
    }
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}
overview {
    workspace-shadow {
        off
    }
}
// Environment for every app niri starts. Startup programs: spawn-at-startup below.
environment {
  XDG_CURRENT_DESKTOP "niri"
  QT_QPA_PLATFORM "wayland;xcb"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORMTHEME "gtk3"
  QT_QPA_PLATFORMTHEME_QT6 "gtk3"
  TERMINAL "kitty"
  // Input method (fcitx5, Vietnamese), per fcitx-im.org "Using Fcitx 5 on Wayland":
  // Qt 6.7+ apps use Wayland's text-input first, then fcitx, instead of the
  // Qt5-style QT_IM_MODULE=fcitx path. QT_IM_MODULE / XMODIFIERS (from
  // ~/.xprofile) stay for Qt5 and X11 apps.
  QT_IM_MODULES "wayland;fcitx"
  // ~/.profile sets these to ibus for GNOME (IBus + Bamboo there). Under niri
  // fcitx5 (+ Bamboo) is the input method: GTK apps use Wayland's text-input,
  // so GTK_IM_MODULE is unset; Qt5 and X11 apps talk to fcitx directly.
  GTK_IM_MODULE null
  QT_IM_MODULE "fcitx"
  XMODIFIERS "@im=fcitx"
  // Java (Swing/AWT) apps such as STM32CubeMX: without this they assume a
  // window manager that wraps windows in frames, so the content does not
  // follow a resize (grey or cut-off area).
  _JAVA_AWT_WM_NONREPARENTING "1"
}
hotkey-overlay {
    skip-at-startup
}
// Same cursor as GNOME (gsettings cursor-theme / cursor-size), so native and
// X11 apps (CubeMX, KiCad) show the same cursor at the same size.
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}
// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://github.com/niri-wm/niri/wiki/Configuration:-Window-Rules
// Later rules win, so this one for all windows comes first.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id=r#"^(org\.gnome\.Settings|gnome-control-center)$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
}
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^xdg-desktop-portal-(gnome|gtk)$"#
    open-floating true
}

// Password prompts (admin rights, keyring): float over the app, never in screen shares
window-rule {
    match app-id=r#"^polkit-gnome-authentication-agent-1$"#
    match app-id=r#"^gcr-prompter$"#
    open-floating true
    block-out-from "screencast"
}

// File manager (Super+E, the dock, the launcher): a normal tiled window like other
// apps. Only its pop-ups float (copy progress, Properties, Rename...): their titles
// don't end in " - Thunar" like the main window's ("Downloads - Thunar").
window-rule {
    // Thunar's app id is "thunar" or "org.xfce.Thunar" depending on version
    match app-id=r#"(?i)^(thunar|org\.xfce\.thunar)$"#
    exclude title=r#" - Thunar$"#
    open-floating true
}
window-rule {
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}
debug {
    honor-xdg-activation-with-invalid-serial
}

// niri's own window switcher with previews: Alt+Tab = all windows,
// Alt+grave = only windows of the same app. Mod+Tab is the overview.
recent-windows {
    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

// ── My workspaces: Mod+1..4 (named ones come first, in this order) ──
workspace "1 Browser"
workspace "2 Dev"
workspace "3 design"
workspace "4 Work Apps"
// where the serial-console scratchpad hides (scripts/scratchpad)
workspace "5 scratchpad"

window-rule {
    // the snap reports "firefox_firefox"
    match app-id=r#"^firefox(_firefox)?$"#
    open-on-workspace "1 Browser"
    open-maximized true
}

window-rule {
    match app-id=r#"(?i)(kicad|eeschema|pcbnew|gerbview)"#
    open-on-workspace "3 design"
}

window-rule {
    match app-id=r#"(?i)^code"#
    open-on-workspace "4 Work Apps"
}

// Serial console scratchpad (Mod+grave): floating drop-down at the top
window-rule {
    match app-id="^serial-scratchpad$"
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.5; }
    default-floating-position x=0 y=40 relative-to="top"
}

// satty (screenshot editor, Print fallback without Flameshot 13): floating over the tiles
window-rule {
    match app-id="^org\\.satty\\.satty$"
    match app-id="^com\\.gabm\\.satty$"
    open-floating true
}

// Flameshot overlay (Print): Flameshot asks for fullscreen, which opens a new column
// and scrolls the view there and back (niri discussion #3751). Floating, not
// fullscreen, at the screen's top-left, it covers the screen and the tiles stay put
// (workaround from flameshot issue #4948). Don't add `open-fullscreen true`: it made
// the overlay close at once.
window-rule {
    match app-id="^flameshot$"
    open-floating true
    open-fullscreen false
    default-floating-position x=0 y=0 relative-to="top-left"
    geometry-corner-radius 0
    border { off; }
    focus-ring { off; }
    shadow { off; }
}

// Datasheets open beside the current window (e.g. next to nvim), half width
window-rule {
    match app-id=r#"^org\.pwmt\.zathura$"#
    match app-id="^sioyek$"
    default-column-width { proportion 0.5; }
    // sioyek restores its last window state (maximized); ignore that
    open-maximized false
    open-maximized-to-edges false
    open-fullscreen false
}

// ── Shell: Noctalia if installed, else waybar/fuzzel/swaync (scripts/shell) ──
// Noctalia rules: docs.noctalia.dev/noctalia/compositor-settings/niri
spawn-sh-at-startup "~/.config/niri/scripts/shell start"
// Vietnamese input (Bamboo); Mod+Space switches English <-> Vietnamese
spawn-at-startup "fcitx5" "-d" "--replace"
// Keep what you copied after its app closes: on Wayland the copied data lives in
// that app (copy a file in Thunar, close Thunar, and the paste was empty). Both shells.
spawn-at-startup "wl-clip-persist" "--clipboard" "regular"

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Stationary wallpaper behind the overview (Noctalia's, or swaybg's from scripts/shell)
layer-rule {
    match namespace="^noctalia-wallpaper"
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// Focus ring colors from the active `theme` profile: scripts/shell (colors)
// writes this file; niri reloads when it changes. Missing (Noctalia, or before
// the first start): niri's default colors.
include optional=true "~/.cache/niri-shell/colors.kdl"

// Launcher (fuzzel): soft shadow, blurred background
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 12
    shadow {
        on
        softness 30
        spread 3
        offset x=0 y=5
        color "#0007"
    }
    background-effect {
        blur true
        xray false
    }
}

// Notifications and their panel stay off screen shares (Teams, OBS via the
// portal; not grim/wf-recorder, which capture the screen directly)
layer-rule {
    match namespace="^(notifications|swaync-notification-window|swaync-control-center)$"
    block-out-from "screencast"
}

// Blur (niri 26.04+). Only visible behind semitransparent windows: the
// terminals (kitty background_opacity / alacritty opacity 0.92).
// Tiled terminals: xray = the blurred wallpaper, computed once and reused
// (cheap; a tiled window has only the wallpaper behind it anyway).
window-rule {
    match app-id="^kitty$"
    match app-id="^Alacritty$"
    background-effect {
        blur true
        xray true
    }
}

// Floating windows: real blur of the windows behind them (niri docs call it
// experimental: recomputed on every change, not shown during open/close).
window-rule {
    match is-floating=true
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

switch-events {
    // logind suspends on lid close by itself (and not when docked); only lock here
    lid-close { spawn "sh" "-c" "~/.config/niri/scripts/shell lock"; }
}

binds {
    // === Panels ===
    // same key as GNOME's input-source switch; the launcher is Mod+D
    Mod+Space hotkey-overlay-title="Input Method: English <-> Vietnamese" { spawn "fcitx5-remote" "-t"; }
    Mod+D hotkey-overlay-title="Application Launcher" { spawn-sh "~/.config/niri/scripts/shell launcher"; }
    Mod+S hotkey-overlay-title="Control Center" { spawn-sh "~/.config/niri/scripts/shell control-center"; }
    Mod+Comma hotkey-overlay-title="Settings" { spawn-sh "~/.config/niri/scripts/shell settings"; }
    Mod+V hotkey-overlay-title="Clipboard History" { spawn-sh "~/.config/niri/scripts/shell clipboard"; }
    Mod+Y hotkey-overlay-title="Wallpapers" { spawn-sh "~/.config/niri/scripts/shell wallpaper"; }
    Mod+X hotkey-overlay-title="Power Menu" { spawn-sh "~/.config/niri/scripts/shell session"; }
    Mod+Alt+L hotkey-overlay-title="Lock Screen" { spawn-sh "~/.config/niri/scripts/shell lock"; }

    // === Audio / brightness / media ===
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell volume-down"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell volume-mute"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell mic-mute"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell media-toggle"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell media-toggle"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell media-next"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell media-previous"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title=null { spawn-sh "~/.config/niri/scripts/shell brightness-down"; }

    // === Screenshots ===
    // Copy: scripts/screenshot runs Flameshot 13.3 (grim takes the picture, then its overlay
    // to pick an area and draw on it); Enter copies, Esc cancels. Without Flameshot 13.x it
    // falls back to satty.
    // Errors go to ~/.cache/niri-shell/screenshot.log.
    Print hotkey-overlay-title="Screenshot: Area + Edit → Copy (Flameshot)" { spawn-sh "~/.config/niri/scripts/screenshot copy"; }
    // same as Print. Insert = this keyboard's PrtSc key without Fn (GNOME binds its
    // screenshot key to Insert for the same reason); Super+Shift+S for keyboards without
    // a Print key
    Insert hotkey-overlay-title="Screenshot: Area + Edit → Copy (Flameshot)" { spawn-sh "~/.config/niri/scripts/screenshot copy"; }
    Mod+Shift+S hotkey-overlay-title="Screenshot: Area + Edit → Copy (Flameshot)" { spawn-sh "~/.config/niri/scripts/screenshot copy"; }
    // Save: niri's own screenshot tool (drag an area; Space or Enter saves to
    // ~/Pictures/Screenshots and also copies, Esc cancels). Mod+Insert needs no Fn.
    Mod+Insert hotkey-overlay-title="Screenshot: Area → Save (niri)" { screenshot; }
    Mod+Print hotkey-overlay-title="Screenshot: Area → Save (niri)" { screenshot; }
    Ctrl+Print hotkey-overlay-title="Screenshot: Full Screen (save + copy)" { spawn-sh "~/.config/niri/scripts/screenshot full"; }
    // GTK apps dark <-> light (terminals, tmux and Neovim keep the theme profile)
    Mod+Shift+D hotkey-overlay-title="Toggle Dark Mode (GTK apps)" { spawn-sh "~/.local/bin/theme gtk"; }
    // click a pixel: its #rrggbb goes to the clipboard (Escape cancels)
    Mod+Shift+C hotkey-overlay-title="Pick Color (copy hex)" { spawn-sh "hex=$(niri msg pick-color | awk '/^Hex:/ {print $2}') && [ -n \"$hex\" ] && wl-copy \"$hex\" && notify-send -t 3000 'Color copied' \"$hex\""; }

    // === System & Overview ===
    Mod+O repeat=false { toggle-overview; }
    Mod+Tab repeat=false { toggle-overview; }

    // Notifications (same as the bar's bell: click / middle click / right click)
    Mod+N hotkey-overlay-title="Notifications: Open Panel" { spawn-sh "~/.config/niri/scripts/shell notifications-panel"; }
    Mod+Shift+N hotkey-overlay-title="Notifications: Clear All" { spawn-sh "~/.config/niri/scripts/shell notifications-clear"; }
    Mod+Ctrl+N hotkey-overlay-title="Notifications: Do Not Disturb" { spawn-sh "~/.config/niri/scripts/shell notifications-dnd"; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // === Application Launchers ===
    // Mod+Enter: kitty attached to tmux session "main" (created if missing), so
    // every window shows the same session; Mod+T: plain kitty for a second view
    Mod+Return hotkey-overlay-title="Terminal (tmux main)" { spawn "kitty" "-e" "tmux" "new-session" "-A" "-s" "main"; }
    Mod+T hotkey-overlay-title="Terminal (plain)" { spawn "kitty"; }
    Mod+E hotkey-overlay-title="Open File Manager" { spawn "thunar"; }
    Mod+Grave hotkey-overlay-title="Serial Console (scratchpad)" { spawn-sh "~/.config/niri/scripts/scratchpad"; }
    // Focus-or-launch: jump to the app if open (again = next window), else start it
    Mod+B hotkey-overlay-title="Browser (focus or launch)" { spawn-sh "~/.config/niri/scripts/focus-or-launch '^firefox(_firefox)?$' firefox"; }
    Mod+P hotkey-overlay-title="PDF / datasheet (focus or launch)" { spawn-sh "~/.config/niri/scripts/focus-or-launch '^(sioyek|org.pwmt.zathura)$' \"$(command -v sioyek || echo zathura)\""; }

    // === Security ===
    Mod+Shift+E { quit; }

    // === Window Management ===
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    // === Focus Navigation ===
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }

    // === Window Movement ===
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+L     { move-column-right; }

    // === Column Navigation ===
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // === Monitor Navigation ===
    Mod+Ctrl+Left  { focus-monitor-left; }
    //Mod+Ctrl+Down  { focus-monitor-down; }
    //Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    // === Move to Monitor ===
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // === Workspace Navigation ===
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // === Move Workspaces ===
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // === Mouse Wheel Navigation ===
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // === Numbered Workspaces ===
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // === Move to Numbered Workspaces ===
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // === Column Management ===
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }

    // === Sizing & Layout ===
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F hotkey-overlay-title="Column: Fill Free Space" { expand-column-to-available-width; }
    Mod+C hotkey-overlay-title="Column: Center" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Columns: Center All Visible" { center-visible-columns; }

    // === Manual Sizing ===
    Mod+Minus hotkey-overlay-title="Column Width -10%" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Column Width +10%" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="Window Height -10%" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Window Height +10%" { set-window-height "+10%"; }

    // === System Controls ===
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    // Screen share: share "niri Dynamic Cast Target" in Teams/Meet once, then pick here
    // what it shows; switch any time without stopping the share
    Mod+Ctrl+W hotkey-overlay-title="Screen Share: This Window" { set-dynamic-cast-window; }
    Mod+Ctrl+M hotkey-overlay-title="Screen Share: This Monitor" { set-dynamic-cast-monitor; }
    Mod+Ctrl+Shift+W hotkey-overlay-title="Screen Share: Stop Showing" { clear-dynamic-cast-target; }
    Mod+Shift+P hotkey-overlay-title="Monitors Off" { power-off-monitors; }
    Alt+Print hotkey-overlay-title="Screenshot: Window" { screenshot-window; }
}
