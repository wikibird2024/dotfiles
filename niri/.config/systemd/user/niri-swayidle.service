# Idle timer for niri without Noctalia. Started by ~/.config/niri/scripts/shell start
# (not enabled: GNOME locks by itself). Restarts whenever it quits, so the lock never
# silently stops; its messages: journalctl --user -u niri-swayidle
#   1 min idle: auto-shutdown starts its countdown (only if turned on, power menu Mod+X)
#   2 min: black cover (scripts/screen-cover; any key/mouse closes it at once, no password)
#   5 min: lock (company rule: max 5 min)   6 min: screens off   before sleep: lock
# Any logind "idle" block lock (systemd-inhibit --what=idle) turns ALL these timers
# off, the lock too: use "shutdown" locks to keep the PC on (auto-shutdown busy).
[Unit]
Description=swayidle for niri (scripts/shell)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/swayidle -w \
    timeout 60 "%h/.local/bin/auto-shutdown idle" resume "%h/.local/bin/auto-shutdown resume" \
    timeout 120 "%h/.config/niri/scripts/screen-cover" resume "pkill -u %u -f niri/scripts/screen-cover" \
    timeout 300 "%h/.config/niri/scripts/shell lock" \
    timeout 360 "niri msg action power-off-monitors" \
    before-sleep "%h/.config/niri/scripts/shell lock"
# also after a clean exit (code 0): on 2026-10-22 it quit that way at a lock and stayed
# off, so the 5 min lock was gone until the next login
Restart=always
RestartSec=2
# stop only swayidle, never the lock screen it started
KillMode=process
