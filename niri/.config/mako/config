# Notifications for niri when Noctalia is not installed (Ubuntu 24.04).
# Colors come from the active `theme` profile: scripts/shell adds them to this
# file in ~/.cache/niri-shell/mako.conf and starts mako with that file.
font=JetBrainsMono Nerd Font 11
border-size=2
border-radius=12
padding=12
margin=10
width=360
default-timeout=5000
max-history=20

[urgency=critical]
default-timeout=0

# volume / brightness OSD from scripts/shell (notify-send -a osd)
[app-name=osd]
anchor=bottom-center
width=240
default-timeout=1500

# do-not-disturb (scripts/shell notifications-dnd): hide all but the OSD
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb app-name=osd]
invisible=0
