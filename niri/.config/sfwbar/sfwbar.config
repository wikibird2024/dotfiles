# Dock on the left edge for niri without Noctalia (Ubuntu 24.04), so someone
# who does not know the keys can still open apps and switch windows.
# Hidden until the pointer touches the left edge; hides again 600 ms after
# the pointer leaves. Started by scripts/shell (start); colors come from
# dock.css + the `theme` palette, in ~/.cache/niri-shell/dock.css.
# Manual: man sfwbar (version 1.0 beta13 on Ubuntu 24.04).

function("SfwbarInit") {
  SetLayer "top"
  # float over windows instead of pushing them aside each time it pops up
  SetExclusiveZone "0"
  SetBarSensor "600"
}

menu("window") {
  item("Close", Close );
  item("Maximize", Maximize );
}

layout {
  button {
    value = "view-app-grid-symbolic"
    tooltip = "Apps (Super+D)"
    action = Exec "~/.config/niri/scripts/shell launcher"
  }
  button {
    value = "org.xfce.thunar"
    tooltip = "Files (Super+E)"
    action = Exec "thunar"
  }
  button {
    value = "firefox"
    tooltip = "Browser (Super+B)"
    action = Exec "~/.config/niri/scripts/focus-or-launch '^firefox$' firefox"
  }
  button {
    value = "kitty"
    tooltip = "Terminal (Super+T)"
    action = Exec "kitty"
  }
  button {
    value = "org.gnome.Settings"
    tooltip = "Settings: Wi-Fi, sound, display (Super+S)"
    action = Exec "~/.config/niri/scripts/shell control-center"
  }

  # open windows: click = go to it, right click = close / maximize
  taskbar {
    style = "windows"
    icons = true
    labels = false
    cols = 1
    action[3] = Menu "window"
  }

  button {
    value = "system-shutdown-symbolic"
    tooltip = "Lock, log out, restart, power off (Super+X)"
    action = Exec "~/.config/niri/scripts/shell session"
  }
}
