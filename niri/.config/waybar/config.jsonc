// Waybar for niri when Noctalia is not installed (Ubuntu 24.04).
// Started by ~/.config/niri/scripts/shell start. Waybar 0.9 has no niri
// module; workspaces come from ~/.config/niri/scripts/waybar-workspaces.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["custom/workspaces"],
    "modules-center": ["group/clock-alerts"],
    "modules-right": ["tray", "group/status", "custom/power"],

    // One pill each. Middle: time and things that need attention (like GNOME).
    // Right: machine status to look at.
    "group/clock-alerts": {
        "orientation": "horizontal",
        "modules": ["clock", "custom/notifications", "custom/auto-shutdown"]
    },
    "group/status": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "network", "memory", "battery"]
    },

    "custom/workspaces": {
        "exec": "~/.config/niri/scripts/waybar-workspaces",
        "format": "{}",
        // no tooltip: it would repeat the workspace list right under the bar
        "tooltip": false,
        "on-click": "niri msg action toggle-overview",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "spacing": 8
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "on-click-right": "~/.config/niri/scripts/shell volume-mute"
    },
    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 LAN",
        "format-disconnected": "󰖪 offline",
        "tooltip-format": "{ifname}  {ipaddr}",
        // Wi-Fi, VPN and wired settings (GNOME Settings); no nm-applet tray icon
        "on-click": "~/.config/niri/scripts/shell control-center"
    },
    // RAM in use; yellow from 80%, red from 90%. Click: htop.
    "memory": {
        "interval": 5,
        "format": "RAM {percentage}%",
        "tooltip-format": "RAM  {used:0.1f} / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "states": { "warning": 80, "critical": 90 },
        "on-click": "kitty -e htop"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "states": { "warning": 20, "critical": 10 }
    },
    // Bell (swaync): click = notification panel, right click = do-not-disturb,
    // middle click = clear all. The number = unread (hidden at 0).
    // restart-interval: reconnect if swaync restarts.
    "custom/notifications": {
        "exec": "~/.config/niri/scripts/waybar-notifications",
        "restart-interval": 5,
        "return-type": "json",
        "format": "{icon}{}",
        "format-icons": {
            "none": "󰂚",
            "notification": "󱅫",
            "dnd-none": "󰂛",
            "dnd-notification": "󰂛",
            "inhibited-none": "󰂚",
            "inhibited-notification": "󱅫",
            "dnd-inhibited-none": "󰂛",
            "dnd-inhibited-notification": "󰂛"
        },
        "escape": true,
        "on-click": "~/.config/niri/scripts/shell notifications-panel",
        "on-click-right": "~/.config/niri/scripts/shell notifications-dnd",
        "on-click-middle": "~/.config/niri/scripts/shell notifications-clear"
    },
    // Shown only while auto shutdown is on (turned on/off in the power menu, Mod+X).
    // Click: the power menu.
    // Refreshed by `pkill -RTMIN+9 waybar` from ~/.local/bin/auto-shutdown.
    "custom/auto-shutdown": {
        "exec": "~/.local/bin/auto-shutdown bar",
        "signal": 9,
        "interval": "once",
        "on-click": "~/.config/niri/scripts/shell session"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/niri/scripts/shell session"
    }
}
