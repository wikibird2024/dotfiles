{
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "auto",
  "hooks": {
    "SessionStart": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook SessionStart", "async": true }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "[ -x ~/.local/bin/auto-shutdown ] && ~/.local/bin/auto-shutdown claude-start || true" }] },
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook UserPromptSubmit", "async": true }] }
    ],
    "PreToolUse": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook PreToolUse", "async": true }] }
    ],
    "PostToolUse": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook PostToolUse", "async": true }] }
    ],
    "PermissionRequest": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook PermissionRequest", "async": true }] }
    ],
    "Notification": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook Notification", "async": true }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "[ -x ~/.local/bin/auto-shutdown ] && ~/.local/bin/auto-shutdown claude-stop || true" }] },
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook Stop", "async": true }] }
    ],
    "StopFailure": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook StopFailure", "async": true }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "[ -x ~/.local/bin/auto-shutdown ] && ~/.local/bin/auto-shutdown claude-stop || true" }] },
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.tmux/plugins/tmux-agent-signal/bin/agent-signal\" hook SessionEnd", "async": true }] }
    ]
  }
}
