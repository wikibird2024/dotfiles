# i3 config — entry point. Reference: https://i3wm.org/docs/userguide.html
#
# Layout (loaded in this order; later files may override earlier ones):
#   conf.d/theme.conf      fonts, borders, gaps, window colours, bar
#   conf.d/keys.conf       every keybinding + resize mode
#   conf.d/rules.conf      workspace assignments, floating rules
#   conf.d/autostart.conf  programs started at login
#   local.conf             this machine only (monitors, wallpaper) — git-ignored,
#                          copy local.conf.example to start one
#
# Workflow: edit -> `i3 -C` (syntax check) -> $mod+Shift+c (reload)
#           exec/bar/gaps changes need $mod+Shift+r (restart, keeps windows)
# Window class for rules: `xprop | grep WM_CLASS`, then click the window.

# Variables are shared with every included file, so define them first.
set $mod Mod4

set $ws1 "1:[1]-Terminal"
set $ws2 "2:[2]-Browser"
set $ws3 "3:[3]-Documents"
set $ws4 "4:[4]-Coding-Apps"
set $ws5 "5:[5]-Work-space-5"
set $ws6 "6:[6]-Chat-Apps"
set $ws7 "7:[7]-Work-space-7"
set $ws8 "8:[8]-Work-space-8"
set $ws9 "9:[9]-Work-space-9"
set $ws10 "10:[10]-Work-space-10"

include ~/.config/i3/conf.d/theme.conf
include ~/.config/i3/conf.d/keys.conf
include ~/.config/i3/conf.d/rules.conf
include ~/.config/i3/conf.d/autostart.conf
include ~/.config/i3/local.conf
